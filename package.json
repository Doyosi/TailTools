  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run test:types",
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "preview": "vite preview --outDir dist/demo",
    "test:types": "tsc -p tests/types/tsconfig.json && tsc -p tests/types/tsconfig.bundler.json",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build --config vite.lib.config.ts && vite build --config vite.umd.config.ts",
    "build:demo": "vite build",
    "prepack": "npm run build:lib",
    "test:package": "node tests/package-check.mjs"
